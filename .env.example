OFFER_ENVIRONMENT=development
OFFER_DATABASE_PATH=data/offer.db
OFFER_ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
OFFER_COOKIE_SECURE=false
OFFER_SESSION_TTL_SECONDS=86400
# Only set this on the backend when business development begins.
DEEPSEEK_API_KEY=

# Real voice interviews: use a key and workspace URL from the same Model Studio region.
# Set only in this backend file; never use VITE_ for secrets.
OFFER_VOICE_API_KEY=
OFFER_VOICE_WEBRTC_URL=
# Example URL: https://YOUR_WORKSPACE_ID.cn-beijing.maas.aliyuncs.com/api/v1/webrtc/realtime
OFFER_VOICE_MODEL=qwen3.8-omni-flash-realtime
OFFER_VOICE_NAME=Tina
OFFER_VOICE_REVIEW_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
OFFER_VOICE_REVIEW_MODEL=qwen-plus
OFFER_VOICE_MAX_MINUTES=15
